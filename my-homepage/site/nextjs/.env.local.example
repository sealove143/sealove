# Supabase (필수 — 항해 상담실 게시판의 회원·질문·답변을 저장합니다)
# URL: Supabase 대시보드 > Project Settings > Data API
# secret 키: Project Settings > API Keys 의 "Secret keys" (sb_secret_...)
# secret 키는 모든 테이블을 읽고 쓸 수 있습니다. 절대 NEXT_PUBLIC_ 을 붙이거나 저장소에 올리지 마세요.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# 질문 작성자 IP를 해시로 남길 때 쓰는 비밀 솔트 (권장). 아무 긴 무작위 문자열이면 됩니다.
# 비워 두면 IP 해시를 남기지 않습니다. 한 번 정하면 바꾸지 마세요(바꾸면 이전 기록과 묶이지 않습니다).
IP_HASH_SALT=

# 배포된 사이트의 실제 주소 (sitemap.xml / robots.txt, 새 질문 알림 메일의 링크에 사용)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Resend API 키 (필수 — 섭외 문의와 새 질문 알림 메일 발송에 사용됩니다)
# https://resend.com/api-keys 에서 발급받아 채워 넣으세요.
RESEND_API_KEY=

# 문의·질문 알림 메일을 받을 주소 (선택, 기본값: powertmdwn351@gmail.com)
CONTACT_TO_EMAIL=powertmdwn351@gmail.com

# 보내는 주소 (선택). Resend에서 도메인을 인증하기 전에는 onboarding@resend.dev만 사용 가능합니다.
# CONTACT_FROM_EMAIL=김승주 항해록 <contact@your-domain.com>
