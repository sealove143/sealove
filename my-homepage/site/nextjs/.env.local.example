# Anthropic API 키 (필수 — 항해 상담실 AI 챗봇에 사용됩니다)
# https://console.anthropic.com/settings/keys 에서 발급받아 채워 넣으세요.
ANTHROPIC_API_KEY=

# 상담실에 사용할 모델 (선택, 기본값: claude-sonnet-5)
# 더 정교한 답변이 필요하면 claude-opus-5로 바꿀 수 있습니다.
ANTHROPIC_MODEL=claude-sonnet-5

# 배포된 사이트의 실제 도메인 (선택 — sitemap.xml / robots.txt에 사용)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Resend API 키 (필수 — 섭외 문의 폼 메일 발송에 사용됩니다)
# https://resend.com/api-keys 에서 발급받아 채워 넣으세요.
RESEND_API_KEY=

# 문의 메일을 받을 주소 (선택, 기본값: powertmdwn351@gmail.com)
CONTACT_TO_EMAIL=powertmdwn351@gmail.com

# 보내는 주소 (선택). Resend에서 도메인을 인증하기 전에는 onboarding@resend.dev만 사용 가능합니다.
# CONTACT_FROM_EMAIL=김승주 항해록 <contact@your-domain.com>
